# =============================================================================
# Diocese of San Pablo — Financial Analytics System
# Environment Variables Template
#
# Copy this file to .env at the repo root and fill in your actual values.
# NEVER commit .env to version control.
# =============================================================================


# -----------------------------------------------------------------------------
# SUPABASE
# Get these from: https://supabase.com/dashboard → Project → Settings → API
# -----------------------------------------------------------------------------

# Your project's public URL  (e.g. https://xxxxxxxxxxxx.supabase.co)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co

# Anon / public key — safe to expose in the browser (Row Level Security enforces access)
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key-here

# Service Role key — SERVER SIDE ONLY, never expose to the browser
# Used by the NestJS backend services to bypass RLS when needed
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key-here

# JWT secret — found in Settings → API → JWT Settings
# Used to verify tokens server-side if you implement custom auth logic
SUPABASE_JWT_SECRET=your-supabase-jwt-secret-here


# -----------------------------------------------------------------------------
# GOOGLE MAPS
# Get from: https://console.cloud.google.com → APIs & Services → Credentials
# Required for the Geospatial Heat Map view
# -----------------------------------------------------------------------------

# Client-side key (exposed to browser) — restrict it to your domain in GCP Console
NEXT_PUBLIC_GOOGLE_MAPS_PLATFORM_KEY=your-google-maps-api-key-here

# Server-side / legacy alias used in next.config.ts (keep both for compatibility)
GOOGLE_MAPS_PLATFORM_KEY=your-google-maps-api-key-here


# -----------------------------------------------------------------------------
# AI FEATURES
# -----------------------------------------------------------------------------

# Gemini API key — used by StewardChatbot (src/components/ui/StewardChatbot.tsx)
# Get from: https://aistudio.google.com/app/apikey
# Leave blank to disable the chatbot in prototype/offline mode
GEMINI_API_KEY=your-gemini-api-key-here

# Anthropic API key — used by claude-cli.js
# Get from: https://console.anthropic.com/settings/api-keys
ANTHROPIC_API_KEY=your-anthropic-api-key-here


# -----------------------------------------------------------------------------
# ANALYTICS (Python / FastAPI)
# -----------------------------------------------------------------------------

# Port for the Python analytics service (default 8000)
ANALYTICS_PYTHON_PORT=8000

# Internal URL used by NestJS to forward analytics requests to Python
ANALYTICS_PYTHON_URL=http://127.0.0.1:8000

# Phase 3 Supabase -> AWS bronze pilot. Keep disabled until Phases 0-2 pass.
WAREHOUSE_PILOT_SYNC_ENABLED=false
WAREHOUSE_PILOT_INSTITUTION_IDS=
WAREHOUSE_PILOT_POLL_SECONDS=30
WAREHOUSE_INSTITUTION_SYNC_ENABLED=false
WAREHOUSE_INSTITUTION_POLL_SECONDS=60
WAREHOUSE_EDUCATION_SYNC_ENABLED=false
WAREHOUSE_EDUCATION_POLL_SECONDS=60
LITURGICAL_CANONICAL_SOURCE=supabase
LITURGICAL_APPROVAL_SYNC_ENABLED=false
LITURGICAL_APPROVAL_POLL_SECONDS=300
WAREHOUSE_SYNC_ALL_PARISHES=false
# Retired compatibility signal; operational AWS mirroring cannot be re-enabled.
WAREHOUSE_BRONZE_COMPARISON_ENABLED=false

# NASA Earthdata Bearer Token — used by the GPM IMERG rainfall validator.
# Without this the third rainfall validator is skipped (lower confidence scores).
# Free account: https://urs.earthdata.nasa.gov/
# After registering: Profile → Generate Token → copy the Bearer token value.
EARTHDATA_BEARER_TOKEN=your-earthdata-bearer-token-here


# -----------------------------------------------------------------------------
# SMTP — OTP / TRANSACTIONAL EMAIL
# Used by the NestJS auth service (nodemailer) to send OTP codes for the
# onboarding form and the Forgot Password flow.
#
# Use the SAME credentials you configured in Supabase → Authentication → SMTP.
# Examples:
#   Gmail:    host smtp.gmail.com, port 587, secure false, pass = App Password
#             (Google Account → Security → 2-Step Verification → App passwords)
#   Brevo:    host smtp-relay.brevo.com, port 587, secure false
#   Resend:   host smtp.resend.com,     port 465, secure true,  user "resend"
#   Mailtrap: host sandbox.smtp.mailtrap.io, port 2525, secure false (testing)
#
# If these are left blank the backend runs in DEV MODE: the OTP code is printed
# to the auth-service console instead of being emailed.
# -----------------------------------------------------------------------------

SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
# true only for port 465 (implicit TLS); false for 587/2525 (STARTTLS)
SMTP_SECURE=false
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-smtp-app-password
# The From header shown in the inbox
SMTP_FROM="Diocese of San Pablo <no-reply@diocesesanpablo.org>"


# -----------------------------------------------------------------------------
# BACKEND / PROXY
# -----------------------------------------------------------------------------

# Base URL the Next.js proxy uses to reach the NestJS API Gateway
# Default: http://127.0.0.1:4000/api  (change for Docker or remote deployments)
BACKEND_PROXY_BASE_URL=http://127.0.0.1:4000/api

# Public URL where the frontend is hosted (used for OAuth redirects, CORS)
FRONTEND_URL=http://localhost:3000


# -----------------------------------------------------------------------------
# APP
# -----------------------------------------------------------------------------

# Node environment: development | production | test
NODE_ENV=development
