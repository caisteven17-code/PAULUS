# =============================================================================
# Diocese of San Pablo — Financial Analytics System
# Environment Variables Template
#
# Copy this file to .env.local and fill in your actual values.
# NEVER commit .env.local to version control.
# =============================================================================


# -----------------------------------------------------------------------------
# SUPABASE
# Get these from: https://supabase.com/dashboard → Project → Settings → API
# -----------------------------------------------------------------------------

# Your project's public URL  (e.g. https://xxxxxxxxxxxx.supabase.co)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co

# Anon / public key — safe to expose in the browser (Row Level Security enforces access)
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# Service Role key — SERVER SIDE ONLY, never expose to the browser
# Used by microservices (src/microservices/) to bypass RLS when needed
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# JWT secret — found in Settings → API → JWT Settings
# Used to verify tokens server-side if you implement custom auth logic
SUPABASE_JWT_SECRET=your-jwt-secret-here


# -----------------------------------------------------------------------------
# APP
# -----------------------------------------------------------------------------

# Full URL where the app is hosted (used for OAuth redirects, API self-calls)
APP_URL=http://localhost:3000

# Node environment: development | production | test
NODE_ENV=development


# -----------------------------------------------------------------------------
# GOOGLE MAPS
# Get from: https://console.cloud.google.com → APIs & Services → Credentials
# Required for the Geospatial Heat Map view
# -----------------------------------------------------------------------------

NEXT_PUBLIC_GOOGLE_MAPS_PLATFORM_KEY=your-google-maps-key-here

# Legacy alias used in next.config.ts (keep both for compatibility)
GOOGLE_MAPS_PLATFORM_KEY=your-google-maps-key-here


# -----------------------------------------------------------------------------
# AI FEATURES
# -----------------------------------------------------------------------------

# Gemini API key — used by StewardChatbot (src/components/ui/StewardChatbot.tsx)
# Get from: https://aistudio.google.com/app/apikey
# Leave blank to disable the chatbot in prototype/offline mode
GEMINI_API_KEY=your-gemini-api-key-here

# Anthropic API key — used by claude-cli.js
# Get from: https://console.anthropic.com/settings/api-keys
ANTHROPIC_API_KEY=your-anthropic-api-key-here
